 "rules": [
  {
   "id": "narrow-no-lobes",
   "level": "error",
   "msg": "Needle/thread/awn blades cannot be lobed."
  },
  {
   "id": "narrow-venation",
   "level": "error",
   "msg": "Needle blades have a single vein or parallel veins only."
  },
  {
   "id": "narrow-base",
   "level": "error",
   "msg": "Needle blades cannot have lobed bases."
  },
  {
   "id": "narrow-simple",
   "level": "error",
   "msg": "Needle blades are simple leaves."
  },
  {
   "id": "strap-lobes",
   "level": "warn",
   "msg": "Strap-shaped blades are rarely lobed."
  },
  {
   "id": "strap-actino",
   "level": "error",
   "msg": "Linear/strap blades cannot carry radiating (actinodromous) primaries."
  },
  {
   "id": "palm-lobes-primary",
   "level": "error",
   "msg": "Palmate lobing needs radiating primaries (actinodromous/palinactinodromous)."
  },
  {
   "id": "pinnate-lobes-primary",
   "level": "warn",
   "msg": "Pinnate lobing normally sits on a pinnate midvein."
  },
  {
   "id": "crasp-needs-ends",
   "level": "error",
   "msg": "Craspedodromous secondaries must end in teeth or lobes; margin is entire and unlobed."
  },
  {
   "id": "semicrasp-needs-teeth",
   "level": "error",
   "msg": "Semicraspedodromous needs a toothed margin."
  },
  {
   "id": "parallel-secondary",
   "level": "fix",
   "msg": "Parallel primaries imply parallelodromous secondaries."
  },
  {
   "id": "parallel-tertiary",
   "level": "fix",
   "msg": "Parallel venation uses transverse cross-veins."
  },
  {
   "id": "parallel-teeth",
   "level": "warn",
   "msg": "Parallel-veined blades are rarely toothed."
  },
  {
   "id": "peltate-primary",
   "level": "error",
   "msg": "Peltate blades have primaries radiating from the attachment (actinodromous)."
  },
  {
   "id": "peltate-base",
   "level": "fix",
   "msg": "Peltate blades have no basal margin; base ignored."
  },
  {
   "id": "cuneiform-lobed-base",
   "level": "error",
   "msg": "Wedge/attenuate bases conflict with lobed bases."
  },
  {
   "id": "obcordate-apex",
   "level": "fix",
   "msg": "Obcordate implies a notched (emarginate) apex."
  },
  {
   "id": "reniform-base",
   "level": "fix",
   "msg": "Reniform implies a cordate base."
  },
  {
   "id": "cordate-shape-base",
   "level": "fix",
   "msg": "Cordate shape implies a cordate base."
  },
  {
   "id": "hastate-shape-base",
   "level": "fix",
   "msg": "Hastate shape implies a hastate base."
  },
  {
   "id": "sagittate-shape-base",
   "level": "fix",
   "msg": "Sagittate shape implies a sagittate base."
  },
  {
   "id": "round-shape-pointed-ends",
   "level": "warn",
   "msg": "Orbicular/reniform blades have rounded ends; acute apex or base will narrow the outline."
  },
  {
   "id": "deltoid-base",
   "level": "warn",
   "msg": "Deltoid blades are usually truncate to subcordate at the base."
  },
  {
   "id": "flabellate-venation",
   "level": "error",
   "msg": "Fan blades need fanning veins (dichotomous, flabellate or actinodromous)."
  },
  {
   "id": "dichotomous-shape",
   "level": "warn",
   "msg": "Dichotomous venation is mostly Ginkgo and ferns."
  },
  {
   "id": "terete-flat",
   "level": "error",
   "msg": "Terete/semiterete leaves have no lobes, teeth or folds."
  },
  {
   "id": "terete-shape",
   "level": "error",
   "msg": "Terete leaves are narrow (linear, acicular, filiform or subulate)."
  },
  {
   "id": "perfoliate-sessile",
   "level": "warn",
   "msg": "Perfoliate leaves are drawn on a stem; shoot view recommended."
  },
  {
   "id": "pedate-structure",
   "level": "error",
   "msg": "Pedate lobing applies to simple palmate blades."
  },
  {
   "id": "cirrate-simple",
   "level": "warn",
   "msg": "A cirrus is a rachis extension; most common on compound leaves and palms."
  },
  {
   "id": "eucamp-teeth",
   "level": "warn",
   "msg": "Eucamptodromous secondaries rarely reach teeth."
  },
  {
   "id": "needle-group",
   "level": "warn",
   "msg": "Needle leaves are typical of conifers."
  },
  {
   "id": "monocot-palmate",
   "level": "warn",
   "msg": "Monocot blades are rarely palmately lobed (palms are plicate)."
  },
  {
   "id": "supervolute-bud",
   "level": "warn",
   "msg": "Supervolute describes leaves in bud; drawn rolled."
  },
  {
   "id": "fenestrate-size",
   "level": "warn",
   "msg": "Fenestrate holes need a broad blade."
  }
 ],
